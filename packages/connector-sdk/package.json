{
  "name": "@pbos/connector-sdk",
  "version": "1.0.0",
  "description": "Provider-neutral SDK and conformance kit for PBOS v1 connectors",
  "license": "ISC",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "pbos-connector-conformance": "dist/cli.js" },
  "files": ["dist", "README.md", "templates"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "default": "./dist/server.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": { "zod": "^4.4.3" }
}
