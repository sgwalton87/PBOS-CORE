# Isolated MB-03 staging model-lease broker. No Genesis or mission state.
# Admin and model HTTPS hostnames must route to this SAME single-instance service.
FROM node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
RUN npm ci --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY pbos ./pbos
COPY tsconfig.json tsconfig.cloud-run.json ./
ENV NODE_ENV=production
USER node
STOPSIGNAL SIGTERM
CMD ["./node_modules/.bin/tsx", "pbos/tools/mb03-staging-model-broker-http.ts"]
